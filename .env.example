NODE_ENV=development
PORT=3001

# DynamoDB (LocalStack em dev)
DYNAMODB_TABLE=execucoes

# Mensageria (SQS/SNS). MESSAGING_DRIVER=memory roda sem AWS; MESSAGING_ENABLED=false roda só a API.
MESSAGING_DRIVER=sqs
MESSAGING_ENABLED=true
EXECUTION_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/execution-commands
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-eventos
OUTBOX_RELAY_INTERVAL_MS=1000

# Segurança — o mesmo JWT_SECRET do OS Service e da Lambda de auth (RFC-003)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# AWS (LocalStack em dev; no EKS vem da LabRole via IMDS)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info

# New Relic (sem licença o agente fica desabilitado)
NEW_RELIC_APP_NAME=execution-service
NEW_RELIC_LICENSE_KEY=
